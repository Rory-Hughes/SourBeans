# Copy to local.properties and enter your own local URL and credentials.
# Choose the URL for your database server and port; there is no shared default.
# MySQL (Rory): jdbc:mysql://localhost:3306/sourbeans
# MariaDB (Josh): jdbc:mariadb://localhost:3306/sourbeans
spring.datasource.url=jdbc:mysql://localhost:3306/sourbeans
spring.datasource.username=sourbeans_app
spring.datasource.password=REPLACE_WITH_YOUR_LOCAL_PASSWORD
